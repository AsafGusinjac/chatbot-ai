# Keeps files identical regardless of which editor touches them.
# VS Code, PhpStorm, Sublime and Notepad++ all honour this (Notepad++ and
# Sublime need a plugin). If a teammate's editor ignores it, tools/check_files.php
# will catch the damage before it reaches the server.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2
